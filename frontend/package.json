{
  "name": "showkart-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings=0",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write src vite.config.ts index.html package.json tsconfig*.json .oxlintrc.json playwright.config.ts e2e",
    "format:check": "prettier --check src vite.config.ts index.html package.json tsconfig*.json .oxlintrc.json playwright.config.ts e2e",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/sora": "5.3.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.27.0",
    "motion": "12.42.2",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "oxlint": "1.76.0",
    "prettier": "3.9.10",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
